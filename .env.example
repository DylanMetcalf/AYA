# Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgres://postgres@localhost:5432/ultima_dev
TEST_DATABASE_URL=postgres://postgres@localhost:5432/ultima_test
# Public base URL used to build invitation links
APP_URL=http://localhost:3000
# Seed admin (only used by `npm run db:seed` on an empty database)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please-123
